(component $Root (type $FT (func (result u32)))
  (component $A (type $FT (func (param "x" u64)))
    (component $N (alias outer $Root $FT (type $FT2))
      (core module $m (func (export "f") (result i32) i32.const 9))
      (core instance $mi (instantiate $m))
      (func $f (type $FT2) (canon lift (core func $mi "f")))
      (export "f" (func $f)))
    (instance $n (instantiate $N)) (alias export $n "f" (func $f)) (export "f" (func $f)))
  (instance $a (instantiate $A)) (alias export $a "f" (func $f)) (export "f" (func $f)))
